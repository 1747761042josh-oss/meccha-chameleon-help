<section class="section">
  <div class="shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">Evidence labels</p>
        <h2>Clear status before confidence.</h2>
      </div>
    </div>
    <div class="status-strip">
      <div>
        <h3>Verified</h3>
        <p>Reserved for future articles with a recorded test environment and repeatable result.</p>
      </div>
      <div>
        <h3>Official Fix</h3>
        <p>Developer notes, Steam announcements, or official support information.</p>
      </div>
      <div>
        <h3>Community Reported</h3>
        <p>Multiple public player reports point to the same issue or workaround.</p>
      </div>
      <div>
        <h3>Unconfirmed</h3>
        <p>Weak evidence, single reports, or information that needs more checking.</p>
      </div>
    </div>
  </div>
</section>
